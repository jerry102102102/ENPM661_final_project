<?xml version="1.0"?>
<package format="3">
  <name>team_car_control</name>
  <version>0.1.0</version>
  <description>ROS2 planner action server and Gazebo executor for the ENPM661 team car.</description>

  <maintainer email="TODO@email.com">ENPM661 Group 4</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>team_car_interfaces</depend>
  <depend>tf2_msgs</depend>

  <exec_depend>team_car_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
